{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "script"
  },
  "rules": {
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-undef": "error",
    "eqeqeq": "warn",
    "curly": "off",
    "brace-style": "off",
    "comma-dangle": "off",
    "comma-spacing": "off",
    "keyword-spacing": "off",
    "space-before-blocks": "off",
    "space-before-function-paren": "off",
    "arrow-spacing": "off",
    "no-var": "warn",
    "prefer-const": "warn",
    "indent": "off",
    "linebreak-style": "off",
    "quotes": "off",
    "semi": "off",
    "no-empty": "warn"
  },
  "globals": {
    "Chart": "readonly",
    "localStorage": "readonly",
    "genId": "readonly",
    "criarInputValorElement": "readonly",
    "criarSpanValorElement": "readonly"
  }
}
